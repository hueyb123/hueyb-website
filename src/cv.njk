---
layout: base.njk
title: "CV | Huey B"
nav: cv
---
    <section class="page-header container">
      <h1>CV</h1>
      <p>Shows and exhibitions from the art practice.</p>
    </section>

    <section class="container">
      <div class="cv-wrap">

        {% if collections.cv | hasCategory("solo") %}
        <div class="cv-section reveal">
          <h2>Solo Exhibitions</h2>
          <ul class="cv-list">
            {% for entry in collections.cv %}
            {% if entry.category == "solo" %}
            <li>
              <span class="cv-year">{{ entry.year }}</span>
              <div class="cv-detail">
                <div class="cv-title">{{ entry.title }}</div>
                <div class="cv-venue">{{ entry.venue }}</div>
              </div>
            </li>
            {% endif %}
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        {% if collections.cv | hasCategory("group") %}
        <div class="cv-section reveal">
          <h2>Group Exhibitions</h2>
          <ul class="cv-list">
            {% for entry in collections.cv %}
            {% if entry.category == "group" %}
            <li>
              <span class="cv-year">{{ entry.year }}</span>
              <div class="cv-detail">
                <div class="cv-title">{{ entry.title }}</div>
                <div class="cv-venue">{{ entry.venue }}</div>
              </div>
            </li>
            {% endif %}
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        {% if collections.cv | hasCategory("residency") %}
        <div class="cv-section reveal">
          <h2>Residencies</h2>
          <ul class="cv-list">
            {% for entry in collections.cv %}
            {% if entry.category == "residency" %}
            <li>
              <span class="cv-year">{{ entry.year }}</span>
              <div class="cv-detail">
                <div class="cv-title">{{ entry.title }}</div>
                <div class="cv-venue">{{ entry.venue }}</div>
              </div>
            </li>
            {% endif %}
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        {% if collections.cv | hasCategory("workshop") %}
        <div class="cv-section reveal">
          <h2>Workshops</h2>
          <ul class="cv-list">
            {% for entry in collections.cv %}
            {% if entry.category == "workshop" %}
            <li>
              <span class="cv-year">{{ entry.year }}</span>
              <div class="cv-detail">
                <div class="cv-title">{{ entry.title }}</div>
                <div class="cv-venue">{{ entry.venue }}</div>
              </div>
            </li>
            {% endif %}
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        {% if collections.cv | hasCategory("education") %}
        <div class="cv-section reveal">
          <h2>Education</h2>
          <ul class="cv-list">
            {% for entry in collections.cv %}
            {% if entry.category == "education" %}
            <li>
              <span class="cv-year">{{ entry.year }}</span>
              <div class="cv-detail">
                <div class="cv-title">{{ entry.title }}</div>
                <div class="cv-venue">{{ entry.venue }}</div>
              </div>
            </li>
            {% endif %}
            {% endfor %}
          </ul>
        </div>
        {% endif %}

      </div>
    </section>
