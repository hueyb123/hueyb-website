---
layout: base.njk
title: "CV | Huey B"
nav: cv
---
    <section class="page-header container">
      <h1>CV</h1>
      <p>Shows and exhibitions from the art practice.</p>
    </section>

    <section class="container">
      <div class="cv-wrap">

        <div class="cv-section reveal">
          <h2>Solo Exhibitions</h2>
          <ul class="cv-list">
            {% for entry in cv.entries | sort(true, false, "year") %}
            {% if entry.category == "solo" %}
            <li>
              <span class="cv-year">{{ entry.year }}</span>
              <div class="cv-detail">
                <div class="cv-title">{{ entry.title }}</div>
                <div class="cv-venue">{{ entry.venue }}</div>
              </div>
            </li>
            {% endif %}
            {% endfor %}
          </ul>
        </div>

        <div class="cv-section reveal">
          <h2>Group Exhibitions</h2>
          <ul class="cv-list">
            {% for entry in cv.entries | sort(true, false, "year") %}
            {% if entry.category == "group" %}
            <li>
              <span class="cv-year">{{ entry.year }}</span>
              <div class="cv-detail">
                <div class="cv-title">{{ entry.title }}</div>
                <div class="cv-venue">{{ entry.venue }}</div>
              </div>
            </li>
            {% endif %}
            {% endfor %}
          </ul>
        </div>

        <div class="cv-section reveal">
          <h2>Education</h2>
          <ul class="cv-list">
            {% for entry in cv.entries | sort(true, false, "year") %}
            {% if entry.category == "education" %}
            <li>
              <span class="cv-year">{{ entry.year }}</span>
              <div class="cv-detail">
                <div class="cv-title">{{ entry.title }}</div>
                <div class="cv-venue">{{ entry.venue }}</div>
              </div>
            </li>
            {% endif %}
            {% endfor %}
          </ul>
        </div>

      </div>
    </section>
