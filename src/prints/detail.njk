---
pagination:
  data: collections.prints
  size: 1
  alias: print
permalink: "prints/{{ print.fileSlug }}/index.html"
layout: base.njk
nav: prints
eleventyComputed:
  title: "{{ print.data.name }} | Huey B"
---
    <a href="/prints/" class="back-button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      Store
    </a>

    <section class="page-header container">
      <h1>{{ print.data.name }}</h1>
    </section>

    <section class="container print-detail">
      {% if print.data.image %}
      <img src="{{ print.data.image }}" alt="{{ print.data.name }}" class="print-image">
      {% endif %}

      {% if print.data.description %}
      <p class="print-description">{{ print.data.description }}</p>
      {% endif %}

      <div class="print-variants" data-print-slug="{{ print.fileSlug }}" data-print-name="{{ print.data.name }}" data-print-image="{{ print.data.image }}">
        {% for variant in print.data.variants %}
        <button type="button" class="variant-option{% if variant.sold_out %} is-sold-out{% endif %}" data-label="{{ variant.label }}" data-price="{{ variant.price }}"{% if variant.sold_out %} disabled{% endif %}>
          <span class="variant-label">{{ variant.label }}</span>
          <span class="variant-price">{% if variant.sold_out %}Sold Out{% else %}${{ variant.price }}{% endif %}</span>
        </button>
        {% endfor %}
      </div>

      <p class="print-shipping-note">Price includes shipping.</p>

      <div class="print-checkout">
        <button type="button" id="add-to-cart-btn" class="btn" disabled>Select a size</button>
        <p class="print-checkout-note" style="display:none;"></p>
      </div>
    </section>
