---
layout: base.njk
title: "Photography | Huey B"
nav: photography
---
    {% for project in collections.photography %}
    {% set coverImage = project.data.cover | thumbnailData(1200) %}
    {% if coverImage %}<link rel="preload" as="image" href="{{ coverImage.url }}">{% endif %}
    {% endfor %}
    <div class="projects-layout">
      <nav class="project-index" aria-label="Jump to piece">
        <h2 class="project-index-title">Photography</h2>
        <ul>
          {% for project in collections.photography %}
          <li>
            <a href="#{{ project.fileSlug }}" class="project-index-link">
              <span class="scramble-target project-scramble" aria-hidden="true">{{ project.data.title }}</span>
              <span class="visually-hidden">{{ project.data.title }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="projects-scroll">
        {% for project in collections.photography %}
        {% set coverImage = project.data.cover | thumbnailData(1200) %}
        <a href="/photography/{{ project.fileSlug }}/" id="{{ project.fileSlug }}" class="project-panel">
          <div class="project-panel-overlay">
            <h3>
              <span class="scramble-target project-scramble" aria-hidden="true">{{ project.data.title }}</span>
              <span class="visually-hidden">{{ project.data.title }}</span>
            </h3>
            {% if project.data.caption %}
            <p>
              <span class="scramble-target project-scramble" aria-hidden="true">{{ project.data.caption }}</span>
              <span class="visually-hidden">{{ project.data.caption }}</span>
            </p>
            {% endif %}
          </div>
          {% if coverImage %}
          <div class="project-panel-image">
            <img src="{{ coverImage.url }}" width="{{ coverImage.width }}" height="{{ coverImage.height }}" alt="">
          </div>
          {% endif %}
        </a>
        {% endfor %}
      </div>
    </div>
