---
layout: base.njk
title: "Huey B"
nav: home
---
    <section class="hero-full">
      <video class="hero-video" autoplay muted loop playsinline></video>
      <div class="hero-scrim"></div>
      <div class="container hero-inner">
        <h1 class="wordmark">
          <span class="scramble-target" aria-hidden="true"></span>
          <span class="visually-hidden">{{ home.title }}</span>
        </h1>
        <p>
          <span class="scramble-target" aria-hidden="true"></span>
          <span class="visually-hidden">{{ home.description }}</span>
        </p>
      </div>
    </section>

    <script>window.HERO_VIDEOS = {{ home.videos | dump | safe }};</script>
