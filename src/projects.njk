---
layout: base.njk
title: "Projects | Huey B"
nav: projects
---
    <section class="page-header container">
      <h1>Projects</h1>
      <p>Current and past projects, spanning the practice over time.</p>
    </section>

    <section class="container">
      {% if collections.projectsCurrent.length %}
      <h2 class="section-heading">Current</h2>
      <div class="tile-grid">
        {% for project in collections.projectsCurrent %}
        <a href="/projects/{{ project.fileSlug }}/" class="tile reveal"{% if project.data.cover %} style="background-image:url('{{ project.data.cover }}');background-size:cover;background-position:center;"{% endif %}>
          <div class="tile-overlay">
            <h3>{{ project.data.title }}</h3>
            <p>{{ project.data.caption }}</p>
          </div>
        </a>
        {% endfor %}
      </div>
      {% endif %}

      {% if collections.projectsPast.length %}
      <h2 class="section-heading">Past</h2>
      <div class="tile-grid">
        {% for project in collections.projectsPast %}
        <a href="/projects/{{ project.fileSlug }}/" class="tile reveal"{% if project.data.cover %} style="background-image:url('{{ project.data.cover }}');background-size:cover;background-position:center;"{% endif %}>
          <div class="tile-overlay">
            <h3>{{ project.data.title }}</h3>
            <p>{{ project.data.caption }}</p>
          </div>
        </a>
        {% endfor %}
      </div>
      {% endif %}
    </section>
