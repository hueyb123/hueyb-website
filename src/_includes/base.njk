<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>

  <header class="site-header">
    <div class="container">
      <a href="/" class="logo">Huey B</a>
      <div class="nav-group">
        <nav class="main-nav">
          <ul>
            <li><a href="/studio/"{% if nav == "studio" %} class="active"{% endif %}>Studio</a></li>
            <li><a href="/projects/"{% if nav == "projects" %} class="active"{% endif %}>Projects</a></li>
            <li><a href="/products/"{% if nav == "products" %} class="active"{% endif %}>Products</a></li>
            <li class="has-dropdown">
              <button type="button" class="dropdown-toggle{% if nav == "cv" or nav == "contact" %} active{% endif %}" aria-haspopup="true" aria-expanded="false">
                About
                <svg class="caret" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <ul class="dropdown-menu">
                <li><a href="/cv/"{% if nav == "cv" %} class="active"{% endif %}>CV</a></li>
                <li><a href="/contact/"{% if nav == "contact" %} class="active"{% endif %}>Contact</a></li>
              </ul>
            </li>
          </ul>
        </nav>
        <div class="header-icons">
          <a href="/products/" class="icon-link" aria-label="Cart">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="9" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg>
            <span class="cart-badge">0</span>
          </a>
          <a href="https://www.instagram.com/huebeeeee/" class="icon-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>
        </div>
      </div>
    </div>
  </header>

  <main class="page-enter">
{{ content | safe }}
  </main>

  <footer class="site-footer{% if revealFooter %} fade-in-item{% else %} page-enter{% endif %}"{% if revealFooter %} style="animation-delay: 600ms;"{% endif %}>
    <div class="container">
      <a href="https://www.instagram.com/huebeeeee/" target="_blank" rel="noopener">@huebeeeee</a>
      <p>&copy; 2026 Huey B. All rights reserved.</p>
    </div>
  </footer>

  <script src="/script.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", function (user) {
        if (!user) {
          window.netlifyIdentity.on("login", function () {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
