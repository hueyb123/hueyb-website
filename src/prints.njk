---
layout: base.njk
title: "Prints | Huey B"
nav: prints
---
    {% if not section_visibility.prints %}
    <section class="page-header container">
      <h1>Browse</h1>
      <p>Fine art prints available for sale.</p>
    </section>

    <section class="container">
      <div class="tile-grid">
        {% for print in collections.prints %}
        <a href="/prints/{{ print.fileSlug }}/" class="tile reveal"{% if print.data.image %} style="background-image:url('{{ print.data.image }}');background-size:cover;background-position:center;"{% endif %}>
          <div class="tile-overlay">
            <h3>{{ print.data.name }}</h3>
            {% if print.data.variants | allSoldOut %}
            <div class="tile-sold-out">Sold Out</div>
            {% else %}
            <div class="tile-price">{% if print.data.variants.length > 1 %}From {% endif %}${{ print.data.variants | minPrice }}</div>
            {% endif %}
          </div>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}
