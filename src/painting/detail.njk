---
pagination:
  data: collections.painting
  size: 1
  alias: post
permalink: "painting/{{ post.fileSlug }}/index.html"
layout: base.njk
nav: painting
revealFooter: true
eleventyComputed:
  title: "{% if post.data.headline %}{{ post.data.headline }}{% elif post.data.date %}{{ post.data.date | readableDate }}{% else %}Untitled{% endif %} | Huey B"
---
    <a href="/painting/{% if post.data.mood == 'Bad Times' %}bad-times{% else %}good-times{% endif %}/" class="back-button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      Painting
    </a>

    {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}" class="post-nav-arrow post-nav-prev" aria-label="Previous post">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </a>
    {% endif %}
    {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}" class="post-nav-arrow post-nav-next" aria-label="Next post">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
    </a>
    {% endif %}

    <section class="container studio-post">
      {% if post.data.date %}
      <p class="studio-post-date fade-in-item" style="animation-delay: 0ms;">{{ post.data.date | readableDate }}</p>
      {% endif %}
      {% if post.data.headline %}
      <h1 class="studio-post-headline fade-in-item" style="animation-delay: 70ms;">{{ post.data.headline }}</h1>
      {% endif %}

      <div class="studio-post-media">
        {% for item in post.data.media | visibleMedia %}
        {% set delay = 160 + loop.index0 * 90 %}
        {% if item.type == "image" %}
        <img src="{{ item.file }}" alt="{{ item.caption or post.data.headline or (post.data.date | readableDate) }}" class="studio-media-image fade-in-item" style="animation-delay: {{ delay }}ms;">
        {% elif item.type == "video" %}
        <video src="{{ item.file }}" controls autoplay muted loop playsinline class="studio-media-video fade-in-item" style="animation-delay: {{ delay }}ms;"></video>
        {% elif item.type == "audio" %}
        <audio src="{{ item.file }}" controls class="studio-media-audio fade-in-item" style="animation-delay: {{ delay }}ms;"></audio>
        {% endif %}
        {% if item.caption %}
        <p class="studio-media-caption fade-in-item" style="animation-delay: {{ delay }}ms;">{{ item.caption }}</p>
        {% endif %}
        {% endfor %}
      </div>

      {% if post.templateContent %}
      <div class="studio-post-body fade-in-item" style="animation-delay: 520ms;">
        {{ post.templateContent | safe }}
      </div>
      {% endif %}
    </section>
