---
layout: base.njk
title: "Good Times | Huey B"
nav: painting
permalink: "painting/gallery/index.html"
---
    <a href="/painting/" class="back-button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      Good Times
    </a>

    <nav class="thumb-sidebar" aria-label="Good Times posts">
      <div class="thumb-sidebar-header">
        <h1>Good Times</h1>
        {% if painting_settings.tagline %}<p>{{ painting_settings.tagline }}</p>{% endif %}
      </div>
      {% for post in collections.painting %}
      {% set cover = post.data.media | firstImage %}
      {% set coverThumb = cover | thumbnail %}
      {% set label = post.data.headline or (post.data.date | readableDate) or "Untitled" %}
      <button type="button" class="thumb-button{% if loop.first %} is-active{% endif %}" data-target="thumb-panel-{{ loop.index0 }}" aria-label="{{ label }}"{% if coverThumb %} style="background-image:url('{{ coverThumb }}')"{% endif %}></button>
      {% endfor %}
    </nav>

    <div class="thumb-layout">
      <div class="thumb-viewer">
        {% for post in collections.painting %}
        {% set isActivePanel = loop.first %}
        <div class="thumb-panel{% if isActivePanel %} is-active{% endif %}" id="thumb-panel-{{ loop.index0 }}">
          {% if post.data.date %}<p class="thumb-panel-date">{{ post.data.date | readableDate }}</p>{% endif %}
          {% if post.data.headline %}<h2 class="thumb-panel-title">{{ post.data.headline }}</h2>{% endif %}
          <div class="thumb-panel-media">
            {% for item in post.data.media %}
            {% if item.type == "image" %}
            <img src="{{ item.file }}" alt="{{ item.caption or post.data.headline or (post.data.date | readableDate) }}" loading="{% if isActivePanel %}eager{% else %}lazy{% endif %}">
            {% elif item.type == "video" %}
            <video src="{{ item.file }}" controls{% if isActivePanel %} autoplay{% endif %} muted loop playsinline preload="{% if isActivePanel %}metadata{% else %}none{% endif %}"></video>
            {% elif item.type == "audio" %}
            <audio src="{{ item.file }}" controls preload="none"></audio>
            {% endif %}
            {% if item.caption %}
            <p class="thumb-panel-caption">{{ item.caption }}</p>
            {% endif %}
            {% endfor %}
          </div>
          {% if post.templateContent %}
          <div class="thumb-panel-details">
            {{ post.templateContent | safe }}
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
