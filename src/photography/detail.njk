---
pagination:
  data: collections.photography
  size: 1
  alias: project
permalink: "photography/{{ project.fileSlug }}/index.html"
layout: base.njk
nav: photography
eleventyComputed:
  title: "{{ project.data.title }} | Huey B"
---
    <a href="/photography/" class="back-button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      Photography
    </a>

    {% if project.data.media and project.data.media.length %}
    <nav class="thumb-sidebar" aria-label="{{ project.data.title }} media">
      <div class="thumb-sidebar-header">
        <h1>{{ project.data.title }}</h1>
        {% if project.data.caption %}<p>{{ project.data.caption }}</p>{% endif %}
      </div>
      {% for item in project.data.media %}
      {% set thumbCover = item.file | thumbnail %}
      <button type="button" class="thumb-button{% if loop.first %} is-active{% endif %}" data-target="thumb-panel-{{ loop.index0 }}" aria-label="{{ item.caption or project.data.title }}"{% if thumbCover %} style="background-image:url('{{ thumbCover }}')"{% endif %}>
        {% if item.type == "video" %}<span class="thumb-icon" aria-hidden="true">&#9654;</span>{% elif item.type == "audio" %}<span class="thumb-icon" aria-hidden="true">&#9834;</span>{% endif %}
      </button>
      {% endfor %}
    </nav>

    <div class="thumb-layout">
      <div class="thumb-viewer">
        {% for item in project.data.media %}
        {% set isActivePanel = loop.first %}
        <div class="thumb-panel{% if isActivePanel %} is-active{% endif %}" id="thumb-panel-{{ loop.index0 }}">
          <div class="thumb-panel-media">
            {% if item.type == "image" %}
            <img src="{{ item.file }}" alt="{{ item.caption or project.data.title }}" loading="{% if isActivePanel %}eager{% else %}lazy{% endif %}">
            {% elif item.type == "video" %}
            <video src="{{ item.file }}" controls{% if isActivePanel %} autoplay{% endif %} muted loop playsinline preload="{% if isActivePanel %}metadata{% else %}none{% endif %}"></video>
            {% elif item.type == "audio" %}
            <audio src="{{ item.file }}" controls preload="none"></audio>
            {% endif %}
            {% if item.caption %}
            <p class="thumb-panel-caption">{{ item.caption }}</p>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>

      {% if project.templateContent %}
      <div class="thumb-description container">
        {{ project.templateContent | safe }}
      </div>
      {% endif %}
    </div>
    {% else %}
    <section class="page-header container">
      <h1>{{ project.data.title }}</h1>
      <p class="thumb-empty">No media yet — check back soon.</p>
    </section>
    {% endif %}
