---
pagination:
  data: collections.photography
  size: 1
  alias: project
permalink: "photography/{{ project.fileSlug }}/index.html"
layout: base.njk
nav: photography
eleventyComputed:
  title: "{{ project.data.title }} | Huey B"
---
    <a href="/photography/" class="back-button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      Photography
    </a>

    <section class="page-header container">
      <h1>{{ project.data.title }}</h1>
    </section>

    <section class="container project-detail">
      {% if project.templateContent %}
      <div class="project-description">
        {{ project.templateContent | safe }}
      </div>
      {% endif %}

      {% for item in project.data.media %}
      {% if item.type == "image" %}
      <img src="{{ item.file }}" alt="{{ item.caption or project.data.title }}" class="project-media-image">
      {% elif item.type == "video" %}
      <video src="{{ item.file }}" controls playsinline class="project-media-video"></video>
      {% elif item.type == "audio" %}
      <audio src="{{ item.file }}" controls class="project-media-audio"></audio>
      {% endif %}
      {% if item.caption %}
      <p class="project-media-caption">{{ item.caption }}</p>
      {% endif %}
      {% endfor %}
    </section>
