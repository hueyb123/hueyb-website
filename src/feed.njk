---
permalink: "feed.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Huey B</title>
    <link>https://hueyb.com/</link>
    <atom:link href="https://hueyb.com/feed.xml" rel="self" type="application/rss+xml" />
    <description>New projects and studio updates from Huey B.</description>
    <language>en</language>
    <lastBuildDate>{{ collections.feedItems | getNewestCollectionItemDate | dateToRfc822 }}</lastBuildDate>
    {%- for item in collections.feedItems %}
    <item>
      <title>{{ item.title }}</title>
      <link>https://hueyb.com{{ item.url }}</link>
      <guid>https://hueyb.com{{ item.url }}</guid>
      <pubDate>{{ item.date | dateToRfc822 }}</pubDate>
    </item>
    {%- endfor %}
  </channel>
</rss>
