---
layout: base.njk
title: "Blog | Huey B"
nav: blog
---
    <section class="page-header container">
      <h1>Blog</h1>
      <p>{{ blog.tagline }}</p>
    </section>

    <section class="container">
      <div class="tile-grid" id="blog-grid">
        {% for post in collections.blogPosts %}
        {% set cover = post.data.media | firstImage %}
        <a href="/blog/{{ post.fileSlug }}/" class="tile reveal"{% if cover %} style="background-image:url('{{ cover }}');background-size:cover;background-position:center;"{% endif %}>
          <div class="tile-overlay">
            <h3>{% if post.data.headline %}{{ post.data.headline }}{% else %}{{ post.data.date | readableDate }}{% endif %}</h3>
            {% if post.data.headline %}<p>{{ post.data.date | readableDate }}</p>{% endif %}
          </div>
        </a>
        {% endfor %}
      </div>
    </section>
