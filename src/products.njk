---
layout: base.njk
title: "Products | Huey B"
nav: products
---
    <section class="page-header container">
      <h1>Products</h1>
      <p>Items currently available for sale.</p>
    </section>

    <section class="container">
      <div class="tile-grid">
        {% for product in collections.products %}
        <div class="tile reveal"{% if product.data.image %} style="background-image:url('{{ product.data.image }}');background-size:cover;background-position:center;"{% endif %}>
          <div class="tile-overlay">
            <h3>{{ product.data.name }}</h3>
            <div class="tile-price">{{ product.data.price }}</div>
            {% if product.data.sold_out %}
            <div class="tile-sold-out">Sold Out</div>
            {% else %}
            <button class="btn">Add to Cart</button>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
    </section>
