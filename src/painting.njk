---
layout: base.njk
title: "Painting | Huey B"
nav: painting
---
    <section class="page-header container">
      <h1>Painting</h1>
      {% if painting_settings.tagline %}<p>{{ painting_settings.tagline }}</p>{% endif %}
    </section>

    <section class="container">
      <div class="tile-grid compact-tile-grid">
        {% for post in collections.painting %}
        {% set cover = post.data.media | firstImage %}
        {% set label = post.data.headline or (post.data.date | readableDate) %}
        <a href="/painting/{{ post.fileSlug }}/" class="tile reveal"{% if cover %} style="background-image:url('{{ cover }}');background-size:cover;background-position:center;"{% endif %}>
          <div class="tile-overlay">
            {% if label %}<h3>{{ label }}</h3>{% endif %}
            {% if post.data.headline and post.data.date %}<p>{{ post.data.date | readableDate }}</p>{% endif %}
          </div>
        </a>
        {% endfor %}
      </div>
    </section>
