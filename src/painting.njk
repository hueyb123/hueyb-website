---
layout: base.njk
title: "Painting | Huey B"
nav: painting
---
    {% if not section_visibility.painting %}
    {% for post in collections.painting %}
    {% set coverPath = post.data.media | firstImage %}
    {% set coverImage = coverPath | thumbnailData(1200) %}
    {% if coverImage %}<link rel="preload" as="image" href="{{ coverImage.url }}">{% endif %}
    {% endfor %}
    <div class="projects-layout">
      <nav class="project-index" aria-label="Jump to piece">
        <h2 class="project-index-title">Painting</h2>
        <ul>
          {% for post in collections.painting %}
          {% set label = post.data.headline or (post.data.date | readableDate) or "Untitled" %}
          <li>
            <a href="#{{ post.fileSlug }}" class="project-index-link">
              <span class="scramble-target project-scramble" aria-hidden="true">{{ label }}</span>
              <span class="visually-hidden">{{ label }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="projects-scroll">
        {% for post in collections.painting %}
        {% set label = post.data.headline or (post.data.date | readableDate) or "Untitled" %}
        {% set coverPath = post.data.media | firstImage %}
        {% set coverImage = coverPath | thumbnailData(1200) %}
        <a href="/painting/{{ post.fileSlug }}/" id="{{ post.fileSlug }}" class="project-panel">
          <div class="project-panel-overlay">
            <h3>
              <span class="scramble-target project-scramble" aria-hidden="true">{{ label }}</span>
              <span class="visually-hidden">{{ label }}</span>
            </h3>
          </div>
          {% if coverImage %}
          <div class="project-panel-image">
            <img src="{{ coverImage.url }}" width="{{ coverImage.width }}" height="{{ coverImage.height }}" alt="">
          </div>
          {% endif %}
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
