---
layout: base.njk
title: "Painting | Huey B"
nav: painting
---
    <nav class="painting-thumbs" aria-label="Painting posts">
      <div class="painting-thumbs-header">
        <h1>Painting</h1>
        {% if painting_settings.tagline %}<p>{{ painting_settings.tagline }}</p>{% endif %}
      </div>
      {% for post in collections.painting %}
      {% set cover = post.data.media | firstImage %}
      {% set label = post.data.headline or (post.data.date | readableDate) or "Untitled" %}
      <button type="button" class="painting-thumb{% if loop.first %} is-active{% endif %}" data-target="painting-panel-{{ loop.index0 }}" aria-label="{{ label }}"{% if cover %} style="background-image:url('{{ cover }}')"{% endif %}></button>
      {% endfor %}
    </nav>

    <div class="painting-layout">
      <div class="painting-viewer">
        {% for post in collections.painting %}
        <div class="painting-panel{% if loop.first %} is-active{% endif %}" id="painting-panel-{{ loop.index0 }}">
          {% if post.data.date %}<p class="painting-panel-date">{{ post.data.date | readableDate }}</p>{% endif %}
          {% if post.data.headline %}<h2 class="painting-panel-title">{{ post.data.headline }}</h2>{% endif %}
          <div class="painting-panel-media">
            {% for item in post.data.media %}
            {% if item.type == "image" %}
            <img src="{{ item.file }}" alt="{{ item.caption or post.data.headline or (post.data.date | readableDate) }}">
            {% elif item.type == "video" %}
            <video src="{{ item.file }}" controls autoplay muted loop playsinline></video>
            {% elif item.type == "audio" %}
            <audio src="{{ item.file }}" controls></audio>
            {% endif %}
            {% if item.caption %}
            <p class="painting-panel-caption">{{ item.caption }}</p>
            {% endif %}
            {% endfor %}
          </div>
          {% if post.templateContent %}
          <div class="painting-panel-details">
            {{ post.templateContent | safe }}
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
