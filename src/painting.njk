---
layout: base.njk
title: "Good Times | Huey B"
nav: painting
---
{% set latestPost = collections.painting | first %}
{% set cover = latestPost.data.media | firstImage if latestPost else null %}
    <div class="projects-layout">
      <nav class="project-index" aria-label="Jump to piece">
        <h2 class="project-index-title">Good Times</h2>
        <ul>
          <li>
            <a href="#painting" class="project-index-link">
              <span class="scramble-target project-scramble" aria-hidden="true"></span>
              <span class="visually-hidden">Good Times</span>
            </a>
          </li>
        </ul>
      </nav>

      <div class="projects-scroll">
        <a href="/painting/gallery/" id="painting" class="project-panel"{% if cover %} style="background-image:url('{{ cover }}');background-size:45%;background-repeat:no-repeat;background-position:75% center;"{% endif %}>
          <div class="project-panel-overlay">
            <h3>
              <span class="scramble-target project-scramble" aria-hidden="true"></span>
              <span class="visually-hidden">Good Times</span>
            </h3>
            {% if painting_settings.tagline %}
            <p>
              <span class="scramble-target project-scramble" aria-hidden="true"></span>
              <span class="visually-hidden">{{ painting_settings.tagline }}</span>
            </p>
            {% endif %}
          </div>
        </a>
      </div>
    </div>
