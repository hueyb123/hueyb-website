---
layout: base.njk
title: "Painting | Huey B"
nav: painting
---
    <div class="projects-layout">
      <nav class="project-index" aria-label="Jump to piece">
        <h2 class="project-index-title">Painting</h2>
        <ul>
          {% for project in collections.painting %}
          <li>
            <a href="#{{ project.fileSlug }}" class="project-index-link">
              <span class="scramble-target project-scramble" aria-hidden="true"></span>
              <span class="visually-hidden">{{ project.data.title }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="projects-scroll">
        {% for project in collections.painting %}
        <a href="/painting/{{ project.fileSlug }}/" id="{{ project.fileSlug }}" class="project-panel"{% if project.data.cover %} style="background-image:url('{{ project.data.cover }}');background-size:45%;background-repeat:no-repeat;background-position:75% center;"{% endif %}>
          <div class="project-panel-overlay">
            <h3>
              <span class="scramble-target project-scramble" aria-hidden="true"></span>
              <span class="visually-hidden">{{ project.data.title }}</span>
            </h3>
            {% if project.data.caption %}
            <p>
              <span class="scramble-target project-scramble" aria-hidden="true"></span>
              <span class="visually-hidden">{{ project.data.caption }}</span>
            </p>
            {% endif %}
          </div>
        </a>
        {% endfor %}
      </div>
    </div>
